# Copy to esphome/secrets.yaml and fill in your local values.
# NEVER commit secrets.yaml to a public repository.

# Wi-Fi credentials
wifi_ssid: "YOUR_WIFI_SSID"
wifi_password: "YOUR_WIFI_PASSWORD"
ap_password: "change-me-ap-fallback"

# ESPHome Native API encryption key (generate via: openssl rand -base64 32)
api_encryption_key: "MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY="

# Web server / OTA credentials (used by web_server digest auth and standalone example)
web_server_username: "YOUR_WEB_USER"
ota_password: "change-me-ota-password"

# MQTT broker (optional: used for birth/will, CAN scan & passive CAN bus monitor)
mqtt_broker: "192.168.1.10"
mqtt_username: "mqtt_user"
mqtt_password: "change-me-mqtt-password"

# Wilo-Smart Connect module BT (Art.-Nr. 4239241) BLE MAC address
wilo_mac_address: "AA:BB:CC:DD:EE:FF"

# Optional fixed session PIN (only needed if you uncomment pin: !secret wilo_pin in wilo_bt.yaml)
wilo_pin: 1234
